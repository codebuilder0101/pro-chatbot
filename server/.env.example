# ============================================================
# LiveKit
# ============================================================
LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ============================================================
# Pipeline de voz
# ============================================================
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
STT_LANGUAGE=pt-BR
# Grafias que o Deepgram deve acertar, separadas por barra vertical.
# Sem isto ele escreve "Yara" no lugar de "IARA". So vale para nova-3.
STT_KEYTERMS=IARA|Ayo

# ATENCAO: o plugin oficial le ELEVEN_API_KEY.
# O codigo aceita ELEVENLABS_API_KEY e faz o alias automaticamente.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5
TTS_LANGUAGE=pt

# inference | multilingual | vad
TURN_DETECTOR=inference

# ============================================================
# Cerebro: fluxo do n8n
# ============================================================
# Nao ha LLM no pipeline. Toda a logica clinica vive no workflow do n8n.
N8N_WEBHOOK_URL=
N8N_AUTH_HEADER=x-iara-token
N8N_AUTH_TOKEN=
N8N_TIMEOUT_S=30
# Turnos de historico enviados no payload. 0 = so o session_id, quando o
# proprio n8n guarda a memoria do fluxo.
N8N_HISTORY_TURNS=10

# --- enchimento de espera ---
# Segundos antes da IARA soltar uma frase curta enquanto o n8n pensa.
# Abaixo de ~0.5 ela fala por cima de resposta que ja estava chegando.
N8N_FILLER_AFTER_S=0.7
# Espera adicional antes da segunda frase, para fluxo longo. 0 desliga.
N8N_SECOND_FILLER_AFTER_S=4
# Separadas por barra vertical (as frases tem virgula).
FILLER_PHRASES=Deixa eu ver aqui.|So um segundo.|Deixa eu conferir.|Um instante.
FILLER_PHRASES_LONG=Ainda estou verificando, ja te respondo.|So mais um pouquinho, estou terminando de olhar.
BRAIN_FAILURE_TEXT=Tive um problema aqui do meu lado e nao consegui buscar a resposta. Pode repetir?

# --- abertura da conversa ---
# local = fala GREETING_TEXT na hora. n8n = pede a abertura ao fluxo.
GREETING_MODE=local
GREETING_TEXT=Oi! Eu sou a IARA. Como posso te ajudar?
# Texto enviado ao n8n quando GREETING_MODE=n8n.
N8N_START_EVENT=__inicio__

# ============================================================
# Avatar
# ============================================================
# heygen | bithuman
AVATAR_ENGINE=heygen

# HeyGen LiveAvatar. O plugin le LIVEAVATAR_API_KEY; o codigo faz alias de HEYGEN_API_KEY.
# Chave em app.liveavatar.com > Settings > API Keys; o avatar_id e' o da conta
# (Avatars) - avatares IMAGE e VIDEO servem. O worker do LiveAvatar entra na
# sala pela internet: LIVEKIT_URL precisa ser wss:// publico, nunca localhost.
# Conferir tudo sem gastar credito: python tests/check_liveavatar.py
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
# very_high | high | medium | low
HEYGEN_VIDEO_QUALITY=high

# bitHuman. O plugin le BITHUMAN_API_SECRET; o codigo faz alias de BITHUMAN_API_KEY.
# So roda em Linux ou macOS ARM - em Windows, use WSL2 ou o container.
BITHUMAN_API_KEY=
# O "Agent code" do console do bitHuman. O plugin chama de avatar_id.
BITHUMAN_AVATAR_ID=
# Alternativa ao avatar_id: modelo .imx rodando dentro do processo do agente.
BITHUMAN_MODEL_PATH=
# essence = acoes predefinidas, roda em CPU (padrao do modo avatar_id).
# expression = expressoes dinamicas, mas a sessao passa a pedir GPU no bitHuman.
BITHUMAN_MODEL=essence

# ============================================================
# Sessao
# ============================================================
SESSION_MAX_MINUTES=20
SESSION_SILENCE_TIMEOUT_S=90

# ============================================================
# Token server
# ============================================================
TOKEN_SERVER_SHARED_SECRET=troque-isto
TOKEN_TTL_MINUTES=25
TOKEN_SERVER_PORT=8080
# Dominio publico do token server (HTTPS): registro A apontando para o VPS.
# O APK e buildado com -Piara.tokenServerUrl=https://ESTE-DOMINIO/
TOKEN_SERVER_DOMAIN=
AGENT_NAME=iara
# Porta do endpoint de saude do worker. O padrao do SDK (8081) colide com
# outros servicos em VPS compartilhado.
AGENT_HTTP_PORT=8081
AGENT_HTTP_HOST=127.0.0.1

# ============================================================
# Instrumentacao
# ============================================================
# true = agente assina o video do avatar e mede o 1o frame de verdade.
# Custa CPU. Ligue para medir HeyGen vs bitHuman, desligue em producao.
MEASURE_AVATAR_VIDEO=false
METRICS_LOG_PATH=

# ============================================================
# Codigos de acesso
# ============================================================
# Quem pode abrir conversa. O segredo do APK e extraivel; o codigo de acesso
# nao mora no app, e digitado pela pessoa e pode ser revogado sem republicar.
# Arquivo que guarda os codigos e o consumo. Fonte da verdade: faca backup.
ACCESS_CODES_PATH=/var/www/pro-chatbot/access_codes.json
# false so em desenvolvimento. O passo 06 do deploy recusa producao sem isto.
ACCESS_CODES_REQUIRED=true
# Protege /admin/codes, que so responde em 127.0.0.1 (nao publicado pelo
# nginx). Gere com: openssl rand -hex 32. Administre com deploy/codes.py.
ADMIN_TOKEN=
# Onde o agente avisa o fim da sessao, para devolver os minutos reservados a
# mais. Vazio desliga o aviso e a reserva do pior caso fica debitada.
TOKEN_SERVER_INTERNAL_URL=http://127.0.0.1:8099

# ============================================================
# Contas de usuario (PostgreSQL)
# ============================================================
# Vazio desliga o cadastro e o servico segue funcionando so com codigo de
# acesso. Preenchido, o /token passa a exigir sessao de usuario.
# Criar no VPS:
#   sudo -u postgres psql -c "CREATE ROLE iara_app LOGIN PASSWORD 'troque';"
#   sudo -u postgres psql -c "CREATE DATABASE iara OWNER iara_app;"
# O esquema e criado sozinho no boot do token server.
DATABASE_URL=
# Quanto tempo a pessoa fica logada sem digitar a senha de novo.
SESSION_DAYS=30
